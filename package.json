{
  "name": "visionguard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-split.mjs",
    "dev:split": "node scripts/dev-split.mjs",
    "dev:together": "node scripts/dev.mjs",
    "ai:setup": "node scripts/ai.mjs setup",
    "ai:dev": "node scripts/ai.mjs dev",
    "ai:test": "node scripts/ai.mjs test",
    "desktop:dev": "npm run dev -w @visionguard/desktop",
    "desktop:build": "npm run build -w @visionguard/desktop",
    "desktop:preview": "npm run preview -w @visionguard/desktop",
    "desktop:test": "npm run test -w @visionguard/desktop",
    "desktop:typecheck": "npm run typecheck -w @visionguard/desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
